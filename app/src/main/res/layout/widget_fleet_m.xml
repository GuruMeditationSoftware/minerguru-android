<?xml version="1.0" encoding="utf-8"?>
<!-- Fleet, 2×2: big hashrate, state and the last 24 hours. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@android:style/Theme.DeviceDefault.DayNight"
    android:background="@drawable/wg_bg"
    android:backgroundTint="@color/wg_surface"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <FrameLayout
            android:id="@+id/wg_mark_bg"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/wg_circle"
            android:backgroundTint="@color/wg_accent_container">
            <ImageView android:id="@+id/wg_mark_frame" android:layout_width="16dp" android:layout_height="16dp" android:layout_gravity="center"
                android:src="@drawable/wg_mark_frame" android:tint="@color/wg_on_accent_container" android:importantForAccessibility="no" />
            <ImageView android:id="@+id/wg_mark_chip" android:layout_width="16dp" android:layout_height="16dp" android:layout_gravity="center"
                android:src="@drawable/wg_mark_chip" android:tint="@color/wg_accent" android:importantForAccessibility="no" />
        </FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <ImageView android:id="@+id/wg_status" android:layout_width="10dp" android:layout_height="10dp" android:src="@drawable/wg_status_online" android:importantForAccessibility="no" />
    </LinearLayout>
    <FrameLayout android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="true">
        <TextView android:id="@+id/wg_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="@android:style/TextAppearance.DeviceDefault" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:fontFeatureSettings="tnum"
            android:textSize="30sp" android:textFontWeight="500" android:letterSpacing="-0.01" android:textColor="@color/wg_text" android:text="16.75" />
        <TextView android:id="@+id/wg_unit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="@android:style/TextAppearance.DeviceDefault" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"
            android:layout_marginStart="3dp" android:textSize="12sp" android:textColor="@color/wg_sub" android:text="TH/s" />
    </LinearLayout>
    <TextView android:id="@+id/wg_status_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@android:style/TextAppearance.DeviceDefault" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:fontFeatureSettings="tnum"
        android:layout_marginTop="2dp" android:textSize="12sp" android:textColor="@color/wg_sub" android:text="5/5 online · 225 W" />
    <ImageView android:id="@+id/wg_spark" android:layout_width="match_parent" android:layout_height="20dp" android:layout_marginTop="8dp"
        android:scaleType="fitXY" android:src="@drawable/wg_spark_preview" android:tint="@color/wg_accent" android:importantForAccessibility="no" />
</LinearLayout>
