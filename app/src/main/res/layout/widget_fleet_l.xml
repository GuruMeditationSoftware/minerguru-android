<?xml version="1.0" encoding="utf-8"?>
<!-- Fleet, 4×2: hashrate with its 24-hour line, power, efficiency and best difficulty. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@android:style/Theme.DeviceDefault.DayNight"
    android:background="@drawable/wg_bg"
    android:backgroundTint="@color/wg_surface"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <FrameLayout
            android:id="@+id/wg_mark_bg"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/wg_circle"
            android:backgroundTint="@color/wg_accent_container">
            <ImageView android:id="@+id/wg_mark_frame" android:layout_width="16dp" android:layout_height="16dp" android:layout_gravity="center"
                android:src="@drawable/wg_mark_frame" android:tint="@color/wg_on_accent_container" android:importantForAccessibility="no" />
            <ImageView android:id="@+id/wg_mark_chip" android:layout_width="16dp" android:layout_height="16dp" android:layout_gravity="center"
                android:src="@drawable/wg_mark_chip" android:tint="@color/wg_accent" android:importantForAccessibility="no" />
        </FrameLayout>
        <TextView android:id="@+id/wg_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textAppearance="@android:style/TextAppearance.DeviceDefault" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"
            android:layout_marginStart="10dp" android:textSize="15sp" android:textFontWeight="500" android:textColor="@color/wg_text" android:text="@string/wg_sample_fleet" />
        <LinearLayout android:id="@+id/wg_pill" android:layout_width="wrap_content" android:layout_height="26dp" android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingHorizontal="10dp" android:background="@drawable/wg_pill_bg" android:backgroundTint="@color/wg_inner">
            <ImageView android:id="@+id/wg_status" android:layout_width="8dp" android:layout_height="8dp" android:src="@drawable/wg_status_online" android:importantForAccessibility="no" />
            <TextView android:id="@+id/wg_status_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="@android:style/TextAppearance.DeviceDefault" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:fontFeatureSettings="tnum"
                android:layout_marginStart="6dp" android:textSize="12sp" android:textFontWeight="500" android:textColor="@color/wg_sub" android:text="5/5 online" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="bottom">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="true">
            <TextView android:id="@+id/wg_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="@android:style/TextAppearance.DeviceDefault" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:fontFeatureSettings="tnum"
                android:textSize="38sp" android:textFontWeight="500" android:letterSpacing="-0.01" android:textColor="@color/wg_text" android:text="16.75" />
            <TextView android:id="@+id/wg_unit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="@android:style/TextAppearance.DeviceDefault" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"
                android:layout_marginStart="4dp" android:textSize="14sp" android:textColor="@color/wg_sub" android:text="TH/s" />
        </LinearLayout>
        <ImageView android:id="@+id/wg_spark" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:layout_marginStart="14dp" android:layout_marginBottom="4dp"
            android:scaleType="fitXY" android:src="@drawable/wg_spark_preview" android:tint="@color/wg_accent" android:importantForAccessibility="no" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
        <LinearLayout android:id="@+id/wg_c1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
             android:orientation="vertical" android:paddingHorizontal="10dp" android:paddingVertical="7dp"
            android:background="@drawable/wg_inner_bg" android:backgroundTint="@color/wg_inner">
            <TextView android:id="@+id/wg_c1l" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@android:style/TextAppearance.DeviceDefault" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"
                android:textSize="11sp" android:textColor="@color/wg_sub" android:text="@string/wg_sample_power" />
            <TextView android:id="@+id/wg_c1v" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@android:style/TextAppearance.DeviceDefault" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:fontFeatureSettings="tnum"
                android:layout_marginTop="2dp" android:textSize="14sp" android:textFontWeight="500" android:textColor="@color/wg_text" android:text="225 W" />
        </LinearLayout>
        <LinearLayout android:id="@+id/wg_c2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="6dp" android:orientation="vertical" android:paddingHorizontal="10dp" android:paddingVertical="7dp"
            android:background="@drawable/wg_inner_bg" android:backgroundTint="@color/wg_inner">
            <TextView android:id="@+id/wg_c2l" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@android:style/TextAppearance.DeviceDefault" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"
                android:textSize="11sp" android:textColor="@color/wg_sub" android:text="@string/wg_sample_efficiency" />
            <TextView android:id="@+id/wg_c2v" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@android:style/TextAppearance.DeviceDefault" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:fontFeatureSettings="tnum"
                android:layout_marginTop="2dp" android:textSize="14sp" android:textFontWeight="500" android:textColor="@color/wg_text" android:text="13.4 J/TH" />
        </LinearLayout>
        <LinearLayout android:id="@+id/wg_c3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="6dp" android:orientation="vertical" android:paddingHorizontal="10dp" android:paddingVertical="7dp"
            android:background="@drawable/wg_inner_bg" android:backgroundTint="@color/wg_inner">
            <TextView android:id="@+id/wg_c3l" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@android:style/TextAppearance.DeviceDefault" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"
                android:textSize="11sp" android:textColor="@color/wg_sub" android:text="Best Diff" />
            <TextView android:id="@+id/wg_c3v" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@android:style/TextAppearance.DeviceDefault" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:fontFeatureSettings="tnum"
                android:layout_marginTop="2dp" android:textSize="14sp" android:textFontWeight="500" android:textColor="@color/wg_text" android:text="886M" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
