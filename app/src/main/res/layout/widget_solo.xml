<?xml version="1.0" encoding="utf-8"?>
<!-- Solo chance of a fleet that mines one coin. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@android:style/Theme.DeviceDefault.DayNight"
    android:background="@drawable/wg_bg"
    android:backgroundTint="@color/wg_surface"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingHorizontal="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/wg_coin" android:layout_width="7dp" android:layout_height="7dp" android:src="@drawable/wg_circle" android:tint="@color/wg_btc" android:importantForAccessibility="no" />
        <TextView android:id="@+id/wg_label" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textAppearance="@android:style/TextAppearance.DeviceDefault" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"
            android:layout_marginStart="6dp" android:textSize="12sp" android:textColor="@color/wg_sub" android:text="@string/wg_sample_solo" />
    </LinearLayout>
    <TextView android:id="@+id/wg_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@android:style/TextAppearance.DeviceDefault" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:fontFeatureSettings="tnum"
        android:layout_marginTop="2dp" android:textSize="18sp" android:textFontWeight="500" android:textColor="@color/wg_text" android:text="@string/wg_sample_odds" />
    <TextView android:id="@+id/wg_status_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@android:style/TextAppearance.DeviceDefault" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"
        android:textSize="11sp" android:textColor="@color/wg_sub" android:text="@string/wg_sample_per_day" />
</LinearLayout>
