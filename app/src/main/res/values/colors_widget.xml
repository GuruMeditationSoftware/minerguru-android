<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widgets, light. Material (Pixel and most launchers): tones of the wallpaper palette, like Google's own
     widgets. One UI: a neutral, slightly see-through card like Samsung's widgets, with the accent of its color palette. -->
<resources>
    <color name="wg_surface">@android:color/system_accent2_50</color>
    <color name="wg_inner">@android:color/system_accent2_100</color>
    <color name="wg_text">@android:color/system_neutral1_900</color>
    <color name="wg_sub">@android:color/system_neutral2_700</color>
    <color name="wg_accent">@android:color/system_accent1_600</color>
    <color name="wg_accent_container">@android:color/system_accent1_100</color>
    <color name="wg_on_accent_container">@android:color/system_accent1_900</color>
    <color name="wg_track">@android:color/system_accent2_100</color>

    <color name="wg_oneui_surface">#E6FFFFFF</color>
    <color name="wg_oneui_inner">#0F000000</color>
    <color name="wg_oneui_text">#FF121212</color>
    <color name="wg_oneui_sub">#FF56575C</color>
    <color name="wg_oneui_accent">@android:color/system_accent1_600</color>
    <color name="wg_oneui_accent_container">#1A000000</color>
    <color name="wg_oneui_on_accent_container">#FF121212</color>
    <color name="wg_oneui_track">#17000000</color>

    <!-- Status block, as in the app -->
    <color name="wg_good">#FF14A06C</color>
    <color name="wg_warning">#FFC77A00</color>
    <color name="wg_bad">#FFC23B3B</color>
    <color name="wg_idle">#FF8A8A8E</color>
    <color name="wg_btc">#FFD9780A</color>
    <!-- Coin dots, as in the app. -->
    <color name="wg_coin_btc">#FFD9780A</color>
    <color name="wg_coin_bch">#FF14A06C</color>
    <color name="wg_coin_dgb">#FF2A78D6</color>
    <color name="wg_coin_xec">#FF0E9F9F</color>
    <color name="wg_coin_bsv">#FFB58A06</color>
    <color name="wg_coin_ppc">#FF4F9A2A</color>
    <color name="wg_coin_nmc">#FF5B6AD0</color>
    <color name="wg_coin_fb">#FF7C5CE0</color>
    <color name="wg_coin_unknown">#FF8A8A8E</color>
</resources>
